# 复制这个文件为 .env，填入真实值

# LLM 配置（DeepSeek，OpenAI 兼容接口）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 视觉模型（可选）—— 只给「以图搜书」POST /search/by-image 用
# 默认用智谱 GLM-4V-Flash（有免费额度，注册即得，演示够用）：
#   https://open.bigmodel.cn  →  API Keys
# ⚠️ 留空**不是错误**：不填的话服务照常起，只有 /search/by-image 回 503
#    并告诉你缺哪个变量。/health 里的 vision.configured 也看这一栏。
VISION_API_KEY=
# 换别家（Qwen-VL 等）改这两行即可，协议都是 OpenAI 兼容
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4v-flash

# Spring Boot 主服务地址（agent 的 tool 要回调它；建索引时也从这里拉帖子）
# 用 127.0.0.1 而不是 localhost：localhost 会同时解析到 IPv4/IPv6，
# 客户端可能先试 IPv6 再失败，表现成「服务明明起着却连不上」。
BOOK_SERVICE_URL=http://127.0.0.1:8080

# HuggingFace 模型下载源（国内必须走镜像，否则第一次跑会卡在下载）
# app/services/embedding.py 里有兜底默认值，这里写出来是为了看得见。
HF_ENDPOINT=https://hf-mirror.com

# 数据库（仅供 scripts/ 下的开发脚本使用；AI 服务本体不直连数据库）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=book_agent
DB_USER=root
DB_PASSWORD=your_password
